{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"strict": true,
		"noEmit": true,
		"noUncheckedIndexedAccess": true,
		"skipLibCheck": true,
		"types": ["node", "bun"],
		"lib": ["ES2022"]
	},
	"include": ["index.ts", "src/**/*.ts", "test/**/*.ts"]
}
